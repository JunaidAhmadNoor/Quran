# Copy to apps/web/.env.local for local development. Never commit real values.
# Every variable is read only on the server unless it starts with NEXT_PUBLIC_.

# --- App --------------------------------------------------------------------
# Production (Railway): https://<service>.up.railway.app until a custom domain is chosen.
# Railway injects PORT; `next start` reads it automatically.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS (the mobile app needs none: it sends Bearer tokens).
API_ALLOWED_ORIGINS=http://localhost:3000

# --- MongoDB Atlas (free M0 cluster, 512 MB) --------------------------------
# Use a dedicated database user with readWrite on this database only.
MONGODB_URI=mongodb://127.0.0.1:27017/tilawah

# --- Better Auth -------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare R2 (free tier: 10 GB, free egress) ---------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tilawah-audio
# Optional. Leave empty to serve approved audio through short-lived signed URLs
# (see "Decisions needed" in docs/ARCHITECTURE.md).
R2_PUBLIC_BASE_URL=

# Without R2, development uses local disk (served by /api/dev-storage). Production needs R2.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/storage

# --- Signing secrets (each: openssl rand -base64 32) -------------------------
# Signs the upload token handed out by POST /uploads/presign.
UPLOAD_TICKET_SECRET=
# Keyed hash for IP addresses in rate limits and play de-duplication. Raw IPs are never stored.
IP_HASH_SECRET=

# --- Email (password reset, email verification) ------------------------------
# brevo = Brevo transactional API over HTTPS (free: 300 emails/day; works on every Railway plan)
# none  = print emails to the terminal (local development and tests)
EMAIL_TRANSPORT=none
# Must be a sender address verified in Brevo (Senders, Domains & Dedicated IPs).
EMAIL_FROM=Tilawah <you@example.com>
# Brevo > Settings > SMTP & API > API keys > Generate a new API key
BREVO_API_KEY=

# --- Memorization model (Phase 4) --------------------------------------------
NEXT_PUBLIC_SPEECH_MODEL_BASE_URL=
